# Copy this file to .env and fill in values from your Supabase project
# (Supabase dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Web push (Phase 6b go-live): npx web-push generate-vapid-keys
# Public half goes here; without it a dev key is used (the subscribe flow works,
# but no push is ever delivered).
VITE_VAPID_PUBLIC_KEY=

# The PRIVATE half never gets a VITE_ prefix — that prefix is what marks a
# variable as safe to compile into the browser bundle. It is not needed to build
# the web app at all; it lives in the Edge Function's secrets:
#   supabase secrets set VAPID_PRIVATE_KEY=... VAPID_PUBLIC_KEY=...
# Keep a local copy here only if you want it handy for that command.
VAPID_PRIVATE_KEY=
