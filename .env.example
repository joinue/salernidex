# Copy this file to .env and fill in values from your Supabase project
# (Supabase dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Web push (Phase 6b go-live): npx web-push generate-vapid-keys
# Public half goes here; private half goes to the Edge Function secrets.
# Without this, a dev key is used (subscribe flow works; no real delivery).
VITE_VAPID_PUBLIC_KEY=
